# Tony Router binds to loopback only by default.
TONY_ROUTER_HOST=127.0.0.1
TONY_ROUTER_PORT=8787

# Optional. When omitted, a 256-bit token is generated and stored at
# ~/.tony-router/token with owner-only permissions where supported.
# Never commit a real token or generated token file.
# TONY_ROUTER_TOKEN=replace-with-at-least-32-non-whitespace-characters
# TONY_ROUTER_TOKEN_FILE=/custom/path/to/token

# Optional server-only secret for account-pinned virtual file IDs. When omitted,
# a separate 256-bit key is generated at ~/.tony-router/file-id-key with
# owner-only permissions where supported. Never expose this key to clients;
# rotating it intentionally invalidates outstanding virtual file IDs.
# TONY_ROUTER_FILE_ID_KEY=replace-with-at-least-32-non-whitespace-characters
# TONY_ROUTER_FILE_ID_KEY_FILE=/custom/path/to/file-id-key

# Required only when binding to a non-loopback address such as 0.0.0.0.
TONY_ROUTER_ALLOW_NON_LOOPBACK=false

TONY_ROUTER_BODY_LIMIT_BYTES=1048576
TONY_ROUTER_REQUEST_TIMEOUT_MS=30000
TONY_ROUTER_SHUTDOWN_GRACE_MS=5000

# Optional OpenAI-compatible upstream. Base URLs ending in /v1 and base URLs
# without /v1 are both supported. Remote upstreams require HTTPS; loopback HTTP
# is accepted for development and contract tests. The API key may be omitted
# for an upstream that intentionally allows unauthenticated local access.
# The upstream timeout is an idle timeout and resets after every response chunk.
# TONY_ROUTER_UPSTREAM_BASE_URL=https://api.openai.com/v1
# TONY_ROUTER_UPSTREAM_API_KEY=replace-with-provider-api-key
TONY_ROUTER_UPSTREAM_TIMEOUT_MS=60000

# Optional routed mode. Configure both files together. Routing v2 supports
# multiple accounts per provider; account API keys are referenced by env name
# from the provider binding JSON and are never stored in either config file.
# TONY_ROUTER_ROUTING_CONFIG_FILE=/path/to/router.yaml
# TONY_ROUTER_PROVIDER_CONFIG_FILE=/path/to/providers.json
# OPENAI_PERSONAL_KEY=replace-with-provider-api-key
# OPENAI_WORK_KEY=replace-with-provider-api-key

# Optional trusted local config control. This is mutually exclusive with the
# legacy upstream and explicit routed-file settings above. It is accepted only
# while the gateway binds to loopback. Tony Router stores validated config
# generations here, never provider API key values.
# TONY_ROUTER_CONTROL_DIR=/absolute/path/to/tony-router-control
