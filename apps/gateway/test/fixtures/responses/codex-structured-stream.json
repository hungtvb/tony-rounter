{
  "model": "tony-auto",
  "stream": true,
  "instructions": "Inspect the screenshot and return JSON only.",
  "input": [
    {
      "role": "user",
      "content": [
        { "type": "input_text", "text": "Identify the visible status." },
        {
          "type": "input_image",
          "image_url": "https://images.example.test/status.png",
          "detail": "low"
        }
      ]
    }
  ],
  "text": {
    "format": {
      "type": "json_schema",
      "name": "status_result",
      "schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "confidence": { "type": "number" }
        },
        "required": ["status", "confidence"],
        "additionalProperties": false
      },
      "strict": true
    }
  }
}
